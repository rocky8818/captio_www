          <div class="w-10 h-10 rounded-xl bg-[#3B6FE8]/10 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-[#3B6FE8]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
