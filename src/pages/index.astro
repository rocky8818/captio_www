      ))}
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════
     DIFFERENTIATORS
═══════════════════════════════════════════ -->
<section class="py-20 px-6 bg-[#1B2E5E] text-white overflow-hidden relative">
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute -top-40 -right-40 w-96 h-96 rounded-full bg-[#3B6FE8]/15 blur-3xl"></div>
    <div class="absolute bottom-0 left-0 w-80 h-80 rounded-full bg-[#3B6FE8]/10 blur-3xl"></div>
  </div>
  <div class="max-w-6xl mx-auto relative">
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl font-black tracking-[-0.03em] mb-4">
        What makes Captio different
      </h2>
      <p class="text-[#A0A8BF] text-lg">
        Not a generic summary. A structured file built for lawyers.
      </p>
    </div>
    <div class="grid md:grid-cols-2 gap-5">
      {[
        {
          title: 'The form is for the client, not the lawyer',
          desc: "The lawyer fills nothing. The client fills the form on their device, in their language, at their pace.",
        },
        {
          title: "The brief speaks the lawyer's language",
          desc: 'Not a generic summary. Follows the structure of a legal file: conflict of interest, key risks, internal legal considerations.',
        },
        {
          title: 'Faithful to the answers — never fabricates',
          desc: "AI never fills in what it doesn't know. If information is missing, it marks it clearly. The lawyer always knows what they have and what's lacking.",
        },
        {
          title: 'Privacy by design',
          desc: "Each firm's data is isolated. Captio doesn't share data between firms or use it to train AI models.",
        },
      ].map(({ title, desc }) => (
