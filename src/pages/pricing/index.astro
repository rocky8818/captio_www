---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Captio — Pricing"
  description="Three plans for law firms, in USD. Solo from $79, Firm from $179, Agency from $279 per month."
  activePage="pricing"
>

<!-- ═══════════════════════════════════════════
     HERO
═══════════════════════════════════════════ -->
<section class="pt-32 pb-12 px-6 text-center relative overflow-hidden">
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[800px] h-[400px] rounded-full bg-[#3B6FE8]/5 blur-3xl"></div>
  </div>
  <div class="max-w-3xl mx-auto relative">
    <div class="inline-flex items-center gap-2 bg-[#EEF1F8] text-[#3B6FE8] text-xs font-bold px-3 py-1.5 rounded-full mb-6 fade-up">
      <span class="w-1.5 h-1.5 rounded-full bg-[#3B6FE8]"></span>
      Price per firm, not per user · USD
    </div>
    <h1 class="text-4xl sm:text-5xl font-black tracking-[-0.04em] text-[#1B2E5E] mb-4 fade-up d1">
      Simple pricing.<br>No surprises.
    </h1>
    <p class="text-lg text-[#6B7694] mb-10 fade-up d2">
      Three plans. Choose based on your firm's size.
    </p>

    <!-- Billing toggle -->
    <div class="inline-flex items-center bg-[#EEF1F8] rounded-xl p-1 gap-1 fade-up d3" role="group">
      <button
        id="btn-monthly"
        onclick="setPricing('monthly')"
        class="px-5 py-2 rounded-lg text-sm font-semibold transition-all bg-white text-[#1B2E5E] shadow-sm"
      >
        Monthly
      </button>
      <button
        id="btn-annual"
        onclick="setPricing('annual')"
        class="px-5 py-2 rounded-lg text-sm font-semibold transition-all text-[#6B7694] flex items-center gap-2"
      >
        Annual
        <span class="bg-[#22C55E]/15 text-[#16a34a] text-xs font-bold px-2 py-0.5 rounded-full">-25%</span>
      </button>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════
     PLANS
═══════════════════════════════════════════ -->
<section class="pb-16 px-6">
  <div class="max-w-4xl mx-auto">
    <div id="plans-grid" data-billing="monthly" class="grid md:grid-cols-3 gap-6">

      <!-- Solo -->
      <div class="bg-white rounded-3xl border border-[#EEF1F8] p-8 shadow-sm hover:shadow-lg hover:shadow-[#3B6FE8]/5 transition-shadow relative overflow-hidden">
        <div class="absolute top-0 right-0 w-24 h-24 bg-[#F8F9FC] rounded-bl-full pointer-events-none"></div>
        <div class="mb-7">
          <p class="text-xs font-bold text-[#6B7694] uppercase tracking-widest mb-1">Solo</p>
          <p class="text-sm text-[#A0A8BF] mb-4">1–3 users</p>

          <div data-billing-show="monthly">
            <div class="flex items-end gap-1 mb-1">
              <span class="text-5xl font-black text-[#1B2E5E] tracking-tight">$79</span>
              <span class="text-[#6B7694] font-medium mb-2">/ month</span>
            </div>
            <p class="text-sm text-[#A0A8BF]">Billed monthly · Cancel anytime</p>
          </div>

          <div data-billing-show="annual">
            <div class="flex items-end gap-1 mb-1">
              <span class="text-5xl font-black text-[#1B2E5E] tracking-tight">$59</span>
              <span class="text-[#6B7694] font-medium mb-2">/ month</span>
            </div>
            <div class="flex items-center gap-2 mb-1">
              <span class="text-sm text-[#6B7694] line-through">$79</span>
              <span class="bg-[#22C55E]/15 text-[#16a34a] text-xs font-bold px-2 py-0.5 rounded-full">Save $240 / year</span>
            </div>
            <p class="text-sm text-[#A0A8BF]">$708 billed annually</p>
          </div>
        </div>

        <ul class="space-y-3 mb-8">
          {[
            'Up to 3 team members',
            'Unlimited cases and briefs',
            'AI brief — 10 sections',
            '5 ways to create a case',
            'Case timeline and notes',
            'Legal Research (SCJN)',
            'Spanish and English',
          ].map((feat) => (
            <li class="flex items-start gap-2.5 text-sm text-[#1A1F36]">
              <svg class="w-4 h-4 text-[#22C55E] mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              {feat}
            </li>
          ))}
        </ul>

        <div data-billing-show="monthly">
          <a
            href="mailto:rickyglz.1318@gmail.com?subject=Access%20request%20%E2%80%94%20Solo%20monthly"
            class="block w-full border-2 border-[#3B6FE8] text-[#3B6FE8] hover:bg-[#3B6FE8] hover:text-white font-bold py-3.5 rounded-xl text-center transition-all text-sm"
          >
            Get started — $79 / month
          </a>
        </div>
        <div data-billing-show="annual">
          <a
            href="mailto:rickyglz.1318@gmail.com?subject=Access%20request%20%E2%80%94%20Solo%20annual"
            class="block w-full border-2 border-[#3B6FE8] text-[#3B6FE8] hover:bg-[#3B6FE8] hover:text-white font-bold py-3.5 rounded-xl text-center transition-all text-sm"
          >
            Get started — $708 / year
          </a>
        </div>
      </div>

      <!-- Firm -->
      <div class="bg-[#1B2E5E] rounded-3xl border border-[#1B2E5E] p-8 shadow-2xl shadow-[#1B2E5E]/30 relative overflow-hidden">
        <div class="absolute top-5 right-5 bg-[#3B6FE8] text-white text-xs font-bold px-3 py-1 rounded-full">Most popular</div>
        <div class="absolute -bottom-10 -right-10 w-48 h-48 rounded-full bg-[#3B6FE8]/10 pointer-events-none"></div>

        <div class="mb-7">
          <p class="text-xs font-bold text-[#6B7694] uppercase tracking-widest mb-1">Firm</p>
          <p class="text-sm text-[#A0A8BF] mb-4">Up to 15 users</p>

          <div data-billing-show="monthly">
            <div class="flex items-end gap-1 mb-1">
              <span class="text-5xl font-black text-white tracking-tight">$179</span>
              <span class="text-[#6B7694] font-medium mb-2">/ month</span>
            </div>
            <p class="text-sm text-[#6B7694]">Billed monthly · Cancel anytime</p>
          </div>

          <div data-billing-show="annual">
            <div class="flex items-end gap-1 mb-1">
              <span class="text-5xl font-black text-white tracking-tight">$134</span>
              <span class="text-[#6B7694] font-medium mb-2">/ month</span>
            </div>
            <div class="flex items-center gap-2 mb-1">
              <span class="text-sm text-[#6B7694] line-through">$179</span>
              <span class="bg-[#22C55E]/15 text-[#22C55E] text-xs font-bold px-2 py-0.5 rounded-full">Save $540 / year</span>
            </div>
            <p class="text-sm text-[#6B7694]">$1,608 billed annually</p>
          </div>
        </div>

        <ul class="space-y-3 mb-8">
          {[
            'Up to 15 team members',
            'Unlimited cases and briefs',
            'AI brief — 10 sections',
            '5 ways to create a case',
            'Case timeline and notes',
            'Legal Research (SCJN)',
            'Spanish and English',
            'Firm reference files',
            'Demo Cases for onboarding',
            'Priority support',
            'Personalized onboarding for your team',
          ].map((feat) => (
            <li class="flex items-start gap-2.5 text-sm text-white/80">
              <svg class="w-4 h-4 text-[#22C55E] mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              {feat}
            </li>
          ))}
        </ul>

        <div data-billing-show="monthly">
          <a
            href="mailto:rickyglz.1318@gmail.com?subject=Access%20request%20%E2%80%94%20Firm%20monthly"
            class="block w-full bg-[#3B6FE8] hover:bg-[#2d5fd4] text-white font-bold py-3.5 rounded-xl text-center transition-all hover:shadow-xl hover:shadow-[#3B6FE8]/40 text-sm"
          >
            Get started — $179 / month
          </a>
        </div>
        <div data-billing-show="annual">
          <a
            href="mailto:rickyglz.1318@gmail.com?subject=Access%20request%20%E2%80%94%20Firm%20annual"
            class="block w-full bg-[#3B6FE8] hover:bg-[#2d5fd4] text-white font-bold py-3.5 rounded-xl text-center transition-all hover:shadow-xl hover:shadow-[#3B6FE8]/40 text-sm"
          >
            Get started — $1,608 / year
          </a>
        </div>
      </div>

      <!-- Agency -->
      <div class="bg-white rounded-3xl border border-[#EEF1F8] p-8 shadow-sm hover:shadow-lg hover:shadow-[#3B6FE8]/5 transition-shadow relative overflow-hidden">
        <div class="absolute top-0 right-0 w-24 h-24 bg-[#F8F9FC] rounded-bl-full pointer-events-none"></div>
        <div class="mb-7">
          <p class="text-xs font-bold text-[#6B7694] uppercase tracking-widest mb-1">Agency</p>
          <p class="text-sm text-[#A0A8BF] mb-4">Up to 30 users</p>

          <div data-billing-show="monthly">
            <div class="flex items-end gap-1 mb-1">
              <span class="text-5xl font-black text-[#1B2E5E] tracking-tight">$279</span>
              <span class="text-[#6B7694] font-medium mb-2">/ month</span>
            </div>
            <p class="text-sm text-[#A0A8BF]">Billed monthly · Cancel anytime</p>
          </div>

          <div data-billing-show="annual">
            <div class="flex items-end gap-1 mb-1">
              <span class="text-5xl font-black text-[#1B2E5E] tracking-tight">$209</span>
              <span class="text-[#6B7694] font-medium mb-2">/ month</span>
            </div>
            <div class="flex items-center gap-2 mb-1">
              <span class="text-sm text-[#6B7694] line-through">$279</span>
              <span class="bg-[#22C55E]/15 text-[#16a34a] text-xs font-bold px-2 py-0.5 rounded-full">Save $840 / year</span>
            </div>
            <p class="text-sm text-[#A0A8BF]">$2,508 billed annually</p>
          </div>
        </div>

        <ul class="space-y-3 mb-8">
          {[
            'Up to 30 team members',
            'Unlimited cases and briefs',
            'AI brief — 10 sections',
            '5 ways to create a case',
            'Case timeline and notes',
            'Legal Research (SCJN)',
            'Spanish and English',
            'Firm reference files',
            'Demo Cases for onboarding',
            'Dedicated support',
            'Personalized onboarding for your team',
            'No annual contract',
          ].map((feat) => (
            <li class="flex items-start gap-2.5 text-sm text-[#1A1F36]">
              <svg class="w-4 h-4 text-[#22C55E] mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              {feat}
            </li>
          ))}
        </ul>

        <div data-billing-show="monthly">
          <a
            href="mailto:rickyglz.1318@gmail.com?subject=Access%20request%20%E2%80%94%20Agency%20monthly"
            class="block w-full border-2 border-[#3B6FE8] text-[#3B6FE8] hover:bg-[#3B6FE8] hover:text-white font-bold py-3.5 rounded-xl text-center transition-all text-sm"
          >
            Get started — $279 / month
          </a>
        </div>
        <div data-billing-show="annual">
          <a
            href="mailto:rickyglz.1318@gmail.com?subject=Access%20request%20%E2%80%94%20Agency%20annual"
            class="block w-full border-2 border-[#3B6FE8] text-[#3B6FE8] hover:bg-[#3B6FE8] hover:text-white font-bold py-3.5 rounded-xl text-center transition-all text-sm"
          >
            Get started — $2,508 / year
          </a>
        </div>
      </div>

    </div>
    <p class="text-center text-sm text-[#A0A8BF] mt-6">
      Firm larger than 30 users? <a href="mailto:rickyglz.1318@gmail.com" class="text-[#3B6FE8] hover:underline">Contact us</a> for a custom plan.
    </p>
  </div>
</section>


<!-- ═══════════════════════════════════════════
     TRIAL
═══════════════════════════════════════════ -->
<section id="trial" class="py-16 px-6">
  <div class="max-w-4xl mx-auto">
    <div class="bg-gradient-to-br from-[#3B6FE8] to-[#1B2E5E] rounded-3xl p-10 text-white text-center relative overflow-hidden shadow-2xl shadow-[#1B2E5E]/30">
      <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
        <div class="absolute -top-20 -right-20 w-64 h-64 rounded-full bg-white/5"></div>
        <div class="absolute -bottom-16 -left-16 w-48 h-48 rounded-full bg-white/5"></div>
      </div>
      <div class="relative">
        <div class="inline-flex items-center gap-2 bg-white/15 text-white text-xs font-bold px-3 py-1.5 rounded-full mb-5">
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/>
          </svg>
          Demo first · Trial activated by Captio
        </div>

        <h2 class="text-3xl sm:text-4xl font-black tracking-[-0.03em] mb-4">
          Not sure yet?<br>Schedule a demo.
        </h2>
        <p class="text-white/70 text-lg mb-8 max-w-xl mx-auto">
          Schedule a 20-minute demo. If Captio fits your firm, we'll activate your access. No credit card. No commitment.
        </p>

        <a
          href="https://cal.com/captio.tech"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 bg-white text-[#1B2E5E] font-bold px-7 py-3.5 rounded-xl transition-all hover:shadow-xl hover:scale-[1.02] text-base"
        >
          <svg class="w-5 h-5 text-[#3B6FE8] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          Schedule demo and start trial
        </a>

        <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 mt-6 text-sm text-white/60">
          {[
            'No credit card',
            'No commitment',
            '20 min demo',
            'Manual activation by Captio',
          ].map((item) => (
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-[#22C55E]" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              {item}
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════
     BILLING FAQ
═══════════════════════════════════════════ -->
<section class="py-12 pb-20 px-6 bg-white">
  <div class="max-w-2xl mx-auto">
    <h2 class="text-2xl font-black tracking-[-0.03em] text-[#1B2E5E] mb-8 text-center">
      Billing questions
    </h2>
    <div class="space-y-3">
      {[
        {
          q: 'How many users does each plan include?',
          a: 'There are three plans. Solo (up to 3 users, $79/mo), Firm (up to 15 users, $179/mo), and Agency (up to 30 users, $279/mo). Price is per firm, not per user.',
        },
        {
          q: 'Can I switch from monthly to annual later?',
          a: 'Yes. You can switch at any time and the 25% discount applies from the next billing cycle.',
        },
        {
          q: 'How does trial access work?',
          a: "Schedule a 20-minute demo. If the product fits your firm, the Captio team activates your access. You'll have full access to all features — no card, no commitment.",
        },
        {
          q: 'What happens to my data if I cancel?',
          a: 'Your data remains available for 30 days after cancellation. You can export your briefs at any time as HTML files.',
        },
      ].map(({ q, a }) => (
        <details class="bg-[#F8F9FC] rounded-2xl border border-[#EEF1F8] overflow-hidden">
          <summary class="flex items-center justify-between gap-4 p-5 font-semibold text-[#1B2E5E] hover:text-[#3B6FE8] transition-colors">
            {q}
            <svg class="icon w-5 h-5 text-[#6B7694] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
            </svg>
          </summary>
          <div class="px-5 pb-5 text-[#6B7694] text-sm leading-relaxed border-t border-[#EEF1F8] pt-4">{a}</div>
        </details>
      ))}
    </div>
  </div>
</section>

</Layout>

<style is:global>
  #btn-monthly, #btn-annual { cursor: pointer; }
  #plans-grid[data-billing="monthly"] [data-billing-show="annual"] { display: none; }
  #plans-grid[data-billing="annual"] [data-billing-show="monthly"] { display: none; }
</style>

<script>
  const btnMonthly = document.getElementById('btn-monthly') as HTMLButtonElement;
  const btnAnnual  = document.getElementById('btn-annual')  as HTMLButtonElement;
  const plansGrid  = document.getElementById('plans-grid')  as HTMLElement;

  window.setPricing = function (type: string) {
    if (type === 'annual') {
      btnAnnual.classList.add('bg-white', 'text-[#1B2E5E]', 'shadow-sm');
      btnAnnual.classList.remove('text-[#6B7694]');
      btnMonthly.classList.remove('bg-white', 'text-[#1B2E5E]', 'shadow-sm');
      btnMonthly.classList.add('text-[#6B7694]');
    } else {
      btnMonthly.classList.add('bg-white', 'text-[#1B2E5E]', 'shadow-sm');
      btnMonthly.classList.remove('text-[#6B7694]');
      btnAnnual.classList.remove('bg-white', 'text-[#1B2E5E]', 'shadow-sm');
      btnAnnual.classList.add('text-[#6B7694]');
    }
    plansGrid.dataset.billing = type;
  };
</script>
