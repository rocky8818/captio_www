---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Captio — Precios"
  description="Planes mensuales y anuales para despachos legales. Intake estructurado y portafolio con IA desde $45/mes."
  activePage="pricing"
>

<!-- ═══════════════════════════════════════════
     HERO
═══════════════════════════════════════════ -->
<section class="pt-32 pb-12 px-6 text-center relative overflow-hidden">
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[800px] h-[400px] rounded-full bg-[#3B6FE8]/5 blur-3xl"></div>
  </div>
  <div class="max-w-3xl mx-auto relative">
    <div class="inline-flex items-center gap-2 bg-[#EEF1F8] text-[#3B6FE8] text-xs font-bold px-3 py-1.5 rounded-full mb-6 fade-up">
      <span class="w-1.5 h-1.5 rounded-full bg-[#3B6FE8]"></span>
      <span class="t-es">Precio por firma, no por usuario</span>
      <span class="t-en">Price per firm, not per user</span>
    </div>
    <h1 class="text-4xl sm:text-5xl font-black tracking-[-0.04em] text-[#1B2E5E] mb-4 fade-up d1">
      <span class="t-es">Pricing simple.<br>Sin sorpresas.</span>
      <span class="t-en">Simple pricing.<br>No surprises.</span>
    </h1>
    <p class="text-lg text-[#6B7694] mb-10 fade-up d2">
      <span class="t-es">Un plan. Todos los miembros de tu firma. Uso ilimitado.</span>
      <span class="t-en">One plan. All your firm's members. Unlimited use.</span>
    </p>

    <!-- Billing toggle -->
    <div class="inline-flex items-center bg-[#EEF1F8] rounded-xl p-1 gap-1 fade-up d3" role="group">
      <button
        id="btn-monthly"
        onclick="setPricing('monthly')"
        class="px-5 py-2 rounded-lg text-sm font-semibold transition-all bg-white text-[#1B2E5E] shadow-sm"
      >
        <span class="t-es">Mensual</span><span class="t-en">Monthly</span>
      </button>
      <button
        id="btn-annual"
        onclick="setPricing('annual')"
        class="px-5 py-2 rounded-lg text-sm font-semibold transition-all text-[#6B7694] flex items-center gap-2"
      >
        <span class="t-es">Anual</span><span class="t-en">Annual</span>
        <span class="bg-[#22C55E]/15 text-[#16a34a] text-xs font-bold px-2 py-0.5 rounded-full">-25%</span>
      </button>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════
     PLANS
═══════════════════════════════════════════ -->
<section class="pb-16 px-6">
  <div class="max-w-4xl mx-auto">
    <div class="grid md:grid-cols-2 gap-6">

      <!-- Monthly -->
      <div class="bg-white rounded-3xl border border-[#EEF1F8] p-8 shadow-sm hover:shadow-lg hover:shadow-[#3B6FE8]/5 transition-shadow relative overflow-hidden">
        <div class="absolute top-0 right-0 w-24 h-24 bg-[#F8F9FC] rounded-bl-full pointer-events-none"></div>
        <div class="mb-7">
          <p class="text-xs font-bold text-[#6B7694] uppercase tracking-widest mb-3">
            <span class="t-es">Mensual</span><span class="t-en">Monthly</span>
          </p>
          <div class="flex items-end gap-1 mb-1">
            <span class="text-5xl font-black text-[#1B2E5E] tracking-tight">$60</span>
            <span class="text-[#6B7694] font-medium mb-2">
              <span class="t-es">/ mes</span><span class="t-en">/ month</span>
            </span>
          </div>
          <p class="text-sm text-[#A0A8BF]">
            <span class="t-es">Facturado mensualmente · Cancela cuando quieras</span>
            <span class="t-en">Billed monthly · Cancel anytime</span>
          </p>
        </div>

        <ul class="space-y-3 mb-8">
          {[
            ['Casos y portafolio ilimitados',              'Unlimited cases and briefs'],
            ['Todos los miembros del equipo incluidos','All team members included'],
            ['Portafolio con IA — 10 secciones',            'AI brief — 10 sections'],
            ['Línea de tiempo y notas de caso',        'Case timeline and notes'],
            ['Español e inglés',                       'Spanish and English'],
            ['Archivos de referencia del despacho',    'Firm reference files'],
            ['Sin contrato anual',                     'No annual contract'],
          ].map(([es, en]) => (
            <li class="flex items-start gap-2.5 text-sm text-[#1A1F36]">
              <svg class="w-4 h-4 text-[#22C55E] mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span class="t-es">{es}</span>
              <span class="t-en">{en}</span>
            </li>
          ))}
        </ul>

        <a
          href="mailto:rickyglz.1318@gmail.com?subject=Solicitud%20de%20acceso%20a%20Captio%20%E2%80%94%20Plan%20mensual"
          class="block w-full border-2 border-[#3B6FE8] text-[#3B6FE8] hover:bg-[#3B6FE8] hover:text-white font-bold py-3.5 rounded-xl text-center transition-all text-sm"
        >
          <span class="t-es">Empezar — $60 / mes</span>
          <span class="t-en">Get started — $60 / month</span>
        </a>
      </div>

      <!-- Annual -->
      <div class="bg-[#1B2E5E] rounded-3xl border border-[#1B2E5E] p-8 shadow-2xl shadow-[#1B2E5E]/30 relative overflow-hidden">
        <div class="absolute top-5 right-5 bg-[#3B6FE8] text-white text-xs font-bold px-3 py-1 rounded-full">
          <span class="t-es">Recomendado</span><span class="t-en">Recommended</span>
        </div>
        <div class="absolute -bottom-10 -right-10 w-48 h-48 rounded-full bg-[#3B6FE8]/10 pointer-events-none"></div>

        <div class="mb-7">
          <p class="text-xs font-bold text-[#6B7694] uppercase tracking-widest mb-3">
            <span class="t-es">Anual</span><span class="t-en">Annual</span>
          </p>
          <div class="flex items-end gap-1 mb-1">
            <span class="text-5xl font-black text-white tracking-tight">$45</span>
            <span class="text-[#6B7694] font-medium mb-2">
              <span class="t-es">/ mes</span><span class="t-en">/ month</span>
            </span>
          </div>
          <div class="flex items-center gap-2 mb-1">
            <span class="text-sm text-[#6B7694] line-through">$60</span>
            <span class="bg-[#22C55E]/15 text-[#22C55E] text-xs font-bold px-2 py-0.5 rounded-full">
              <span class="t-es">Ahorras $180 / año</span><span class="t-en">Save $180 / year</span>
            </span>
          </div>
          <p class="text-sm text-[#6B7694]">
            <span class="t-es">$540 facturado anualmente</span>
            <span class="t-en">$540 billed annually</span>
          </p>
        </div>

        <ul class="space-y-3 mb-8">
          {[
            ['Todo lo del plan mensual',                           'Everything in the monthly plan'],
            ['25% de descuento — $180 de ahorro al año',          '25% discount — $180 saved per year'],
            ['Soporte prioritario',                                'Priority support'],
            ['Onboarding personalizado para el equipo',           'Personalized onboarding for your team'],
            ['Acceso anticipado a nuevas funciones',              'Early access to new features'],
          ].map(([es, en]) => (
            <li class="flex items-start gap-2.5 text-sm text-white/80">
              <svg class="w-4 h-4 text-[#22C55E] mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span class="t-es">{es}</span>
              <span class="t-en">{en}</span>
            </li>
          ))}
        </ul>

        <a
          href="mailto:rickyglz.1318@gmail.com?subject=Solicitud%20de%20acceso%20a%20Captio%20%E2%80%94%20Plan%20anual"
          class="block w-full bg-[#3B6FE8] hover:bg-[#2d5fd4] text-white font-bold py-3.5 rounded-xl text-center transition-all hover:shadow-xl hover:shadow-[#3B6FE8]/40 text-sm"
        >
          <span class="t-es">Empezar — $540 / año</span>
          <span class="t-en">Get started — $540 / year</span>
        </a>
      </div>

    </div>
    <p class="text-center text-sm text-[#A0A8BF] mt-6">
      <span class="t-es">Ambos planes incluyen todas las funciones. La diferencia es solo el ciclo de facturación.</span>
      <span class="t-en">Both plans include all features. The only difference is the billing cycle.</span>
    </p>
  </div>
</section>


<!-- ═══════════════════════════════════════════
     TRIAL
═══════════════════════════════════════════ -->
<section id="trial" class="py-16 px-6">
  <div class="max-w-4xl mx-auto">
    <div class="bg-gradient-to-br from-[#3B6FE8] to-[#1B2E5E] rounded-3xl p-10 text-white text-center relative overflow-hidden shadow-2xl shadow-[#1B2E5E]/30">
      <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
        <div class="absolute -top-20 -right-20 w-64 h-64 rounded-full bg-white/5"></div>
        <div class="absolute -bottom-16 -left-16 w-48 h-48 rounded-full bg-white/5"></div>
      </div>
      <div class="relative">
        <div class="inline-flex items-center gap-2 bg-white/15 text-white text-xs font-bold px-3 py-1.5 rounded-full mb-5">
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/>
          </svg>
          <span class="t-es">Trial gratuito · 7 días</span>
          <span class="t-en">Free trial · 7 days</span>
        </div>

        <h2 class="text-3xl sm:text-4xl font-black tracking-[-0.03em] mb-4">
          <span class="t-es">¿No estás seguro aún?<br>Pruébalo durante 7 días.</span>
          <span class="t-en">Not sure yet?<br>Try it for 7 days.</span>
        </h2>
        <p class="text-white/70 text-lg mb-8 max-w-xl mx-auto">
          <span class="t-es">Agenda una demo de 20 minutos y te activamos un trial completo de 7 días para tu firma. Sin tarjeta de crédito. Sin compromiso.</span>
          <span class="t-en">Schedule a 20-minute demo and we'll activate a full 7-day trial for your firm. No credit card. No commitment.</span>
        </p>

        <!-- Replace with your Calendly / cal.com link -->
        <a
          href="mailto:rickyglz.1318@gmail.com?subject=Quiero%20agendar%20una%20demo%20de%20Captio"
          class="inline-flex items-center justify-center gap-2 bg-white text-[#1B2E5E] font-bold px-7 py-3.5 rounded-xl transition-all hover:shadow-xl hover:scale-[1.02] text-base"
        >
          <svg class="w-5 h-5 text-[#3B6FE8] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          <span class="t-es">Agendar demo y empezar trial</span>
          <span class="t-en">Schedule demo and start trial</span>
        </a>

        <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 mt-6 text-sm text-white/60">
          {[
            ['Sin tarjeta de crédito', 'No credit card'],
            ['Sin compromiso',         'No commitment'],
            ['Demo de 20 min',         '20 min demo'],
            ['Acceso completo 7 días', 'Full access 7 days'],
          ].map(([es, en]) => (
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-[#22C55E]" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span class="t-es">{es}</span>
              <span class="t-en">{en}</span>
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════
     BILLING FAQ
═══════════════════════════════════════════ -->
<section class="py-12 pb-20 px-6 bg-white">
  <div class="max-w-2xl mx-auto">
    <h2 class="text-2xl font-black tracking-[-0.03em] text-[#1B2E5E] mb-8 text-center">
      <span class="t-es">Preguntas sobre facturación</span>
      <span class="t-en">Billing questions</span>
    </h2>
    <div class="space-y-3">
      {[
        {
          qEs: '¿Cuántos usuarios incluye el plan?',
          qEn: 'How many users does the plan include?',
          aEs: 'Todos. El precio es por firma, no por usuario. Un abogado, diez — mismo precio. Abogados titulares, asociados, asistentes y recepcionistas pueden usar Captio sin costo adicional.',
          aEn: 'All of them. The price is per firm, not per user. One lawyer, ten — same price. Partners, associates, assistants, and receptionists can use Captio at no extra cost.',
        },
        {
          qEs: '¿Puedo cambiar de mensual a anual después?',
          qEn: 'Can I switch from monthly to annual later?',
          aEs: 'Sí. Puedes hacer el cambio en cualquier momento y el descuento del 25% se aplica desde el siguiente ciclo de facturación.',
          aEn: 'Yes. You can switch at any time and the 25% discount applies from the next billing cycle.',
        },
        {
          qEs: '¿Qué incluye el trial de 7 días?',
          qEn: 'What does the 7-day trial include?',
          aEs: 'Acceso completo a todas las funciones — sin restricciones. Casos ilimitados, portafolio con IA, todos los miembros del equipo. Al finalizar los 7 días puedes elegir el plan o cancelar sin cargo.',
          aEn: 'Full access to all features — no restrictions. Unlimited cases, AI briefs, all team members. After 7 days you can choose a plan or cancel with no charge.',
        },
        {
          qEs: '¿Qué pasa con mis datos si cancelo?',
          qEn: 'What happens to my data if I cancel?',
          aEs: 'Tus datos permanecen disponibles durante 30 días después de la cancelación. Puedes exportar tus portafolio en cualquier momento como archivos HTML.',
          aEn: 'Your data remains available for 30 days after cancellation. You can export your briefs at any time as HTML files.',
        },
      ].map(({ qEs, qEn, aEs, aEn }) => (
        <details class="bg-[#F8F9FC] rounded-2xl border border-[#EEF1F8] overflow-hidden">
          <summary class="flex items-center justify-between gap-4 p-5 font-semibold text-[#1B2E5E] hover:text-[#3B6FE8] transition-colors">
            <span class="t-es">{qEs}</span>
            <span class="t-en">{qEn}</span>
            <svg class="icon w-5 h-5 text-[#6B7694] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
            </svg>
          </summary>
          <div class="px-5 pb-5 text-[#6B7694] text-sm leading-relaxed border-t border-[#EEF1F8] pt-4">
            <span class="t-es">{aEs}</span>
            <span class="t-en">{aEn}</span>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

</Layout>

<style is:global>
  /* Pricing toggle button states */
  #btn-monthly, #btn-annual { cursor: pointer; }
</style>

<script>
  const btnMonthly = document.getElementById('btn-monthly') as HTMLButtonElement;
  const btnAnnual  = document.getElementById('btn-annual')  as HTMLButtonElement;

  window.setPricing = function (type: string) {
    if (type === 'annual') {
      btnAnnual.classList.add('bg-white', 'text-[#1B2E5E]', 'shadow-sm');
      btnAnnual.classList.remove('text-[#6B7694]');
      btnMonthly.classList.remove('bg-white', 'text-[#1B2E5E]', 'shadow-sm');
      btnMonthly.classList.add('text-[#6B7694]');
    } else {
      btnMonthly.classList.add('bg-white', 'text-[#1B2E5E]', 'shadow-sm');
      btnMonthly.classList.remove('text-[#6B7694]');
      btnAnnual.classList.remove('bg-white', 'text-[#1B2E5E]', 'shadow-sm');
      btnAnnual.classList.add('text-[#6B7694]');
    }
  };
</script>
